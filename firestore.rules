rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Verificación de estado de conexión
    match /_status_check/{document=**} {
      allow read, write: if true;
    }

    // Usuarios del sistema (Solo usuarios autenticados)
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Inventario y Salidas (Solo personal autenticado)
    match /inventory/{itemId} {
      allow read, write: if request.auth != null;
    }

    match /outgoings/{outgoingId} {
      allow read, write: if request.auth != null;
    }

    // Vehículos: Lectura pública (para portal de clientes), Escritura solo personal autenticado
    match /vehicles/{vehicleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Fotos y Documentos de Vehículos: Lectura pública, Escritura autenticada
    match /vehicle_photos/{photoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /vehicle_docs/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Bitácora / Actualizaciones de Vehículos: Lectura pública, Escritura autenticada
    match /vehicle_updates/{updateId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Comentarios y Consultas: Lectura pública, Creación pública (clientes pueden comentar), Modificación/Borrado solo personal
    match /vehicle_comments/{commentId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    // Facturas y Documentos PDF de Facturas (Solo personal autenticado)
    match /invoices/{invoiceId} {
      allow read, write: if request.auth != null;
    }

    match /invoice_docs/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
